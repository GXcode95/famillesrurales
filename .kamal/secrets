# Charge les variables depuis .env.kamal (gitignored via /.env*)
set -a
. ./.env.kamal
set +a

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# Si SECRET_KEY_BASE absent, dérive une valeur stable depuis master.key (dev) ou génère
if [ -z "${SECRET_KEY_BASE:-}" ]; then
  if [ -f config/master.key ]; then
    SECRET_KEY_BASE=$(tr -d '\n\r' < config/master.key)$(tr -d '\n\r' < config/master.key)
  fi
fi
SECRET_KEY_BASE=$SECRET_KEY_BASE
