# Charge .env.kamal en local s'il existe (ignoré en CI : secrets via env GitHub Actions)
if [ -f ./.env.kamal ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env.kamal
  set +a
fi

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

if [ -z "${SECRET_KEY_BASE:-}" ] && [ -f config/master.key ]; then
  SECRET_KEY_BASE=$(tr -d '\n\r' < config/master.key)$(tr -d '\n\r' < config/master.key)
fi
SECRET_KEY_BASE=$SECRET_KEY_BASE
